# Copy to .env.production (or set in CI) before `npm run build`.
# The build fails if VITE_API_BASE_URL is missing.

# Public API origin, including the /api/v1 prefix.
VITE_API_BASE_URL=https://api.example.com/api/v1

# Optional: browser error reporting. Leave empty to disable Sentry.
VITE_SENTRY_DSN=
# Optional: release identifier (e.g. the git SHA), shared with source map upload.
VITE_RELEASE=
# Support address shown on the privacy and refund pages.
VITE_CONTACT_EMAIL=support@example.com
# Optional: Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY on the API).
VITE_TURNSTILE_SITE_KEY=
# Optional: Google OAuth client ID (must match GOOGLE_CLIENT_ID on the API).
VITE_GOOGLE_CLIENT_ID=

# Build-time only (never exposed to the browser): upload source maps to Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
