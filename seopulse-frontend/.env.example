VITE_API_BASE_URL=http://localhost:8082/api/v1
# Optional: browser error reporting via Sentry.
VITE_SENTRY_DSN=
# Support address shown on the privacy and refund pages.
VITE_CONTACT_EMAIL=support@seopulse.app
# Optional: Cloudflare Turnstile site key. Shows a security check on sign-up and
# the landing-page quick check. Pair with TURNSTILE_SECRET_KEY on the backend.
VITE_TURNSTILE_SITE_KEY=
# Optional: Google OAuth client ID. Shows "Continue with Google" on sign-in and
# sign-up. Must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=
