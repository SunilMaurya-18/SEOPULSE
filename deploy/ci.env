# Throwaway values for docker-compose.ci.yml (CI and local runs only).
# BACKUP_AGE_RECIPIENT is generated per run; see .github/workflows/ci.yml.
IMAGE_REGISTRY=seopulse-ci
IMAGE_TAG=ci
APP_DOMAIN=localhost
ACME_EMAIL=ci@example.com
DB_PASSWORD=ci_only_db_password
REDIS_PASSWORD=ci_only_redis_password
JWT_SECRET=ci-only-jwt-secret-that-is-at-least-32-bytes-long
SENTRY_ENVIRONMENT=ci
# A fresh account must be able to run an audit without clicking an email link.
SEOPULSE_AUTH_REQUIRE_EMAIL_VERIFICATION=false
SEOPULSE_AUTH_BREACHED_PASSWORD_CHECK=false
BACKUP_S3_BUCKET=seopulse-backups
BACKUP_S3_PREFIX=ci
BACKUP_S3_ENDPOINT=http://s3:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=ci-access-key
BACKUP_S3_SECRET_ACCESS_KEY=ci-secret-key-not-for-production
