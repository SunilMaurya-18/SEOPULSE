# Copy to /opt/seopulse/.env on the server (chmod 600). Never commit the real file.
# Generate secrets with:  openssl rand -base64 48

# --- Images (IMAGE_TAG is set by deploy.sh on every deploy) -------------------
IMAGE_REGISTRY=ghcr.io/your-github-user-lowercase
IMAGE_TAG=replace-with-a-commit-sha

# --- Domain and TLS -----------------------------------------------------------
# DNS A/AAAA records must point at this server before the first start.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# --- Database -----------------------------------------------------------------
DB_NAME=seopulse
DB_USERNAME=seopulse
DB_PASSWORD=

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=

# --- Auth ---------------------------------------------------------------------
# At least 32 bytes. Rotating it signs everyone out.
JWT_SECRET=
# Defaults to https://${APP_DOMAIN}; comma-separate to allow more origins.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SEOPULSE_BOT_INFO_URL=https://app.example.com/bot
SEOPULSE_AUTH_REQUIRE_EMAIL_VERIFICATION=false
SEOPULSE_AUTH_BREACHED_PASSWORD_CHECK=true
SEOPULSE_RATE_LIMIT_ENABLED=true

# --- Worker -------------------------------------------------------------------
WORKER_REPLICAS=1
SEOPULSE_WORKER_CONCURRENCY=2

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Only used with: docker compose --profile monitoring up -d
GRAFANA_ADMIN_PASSWORD=

# --- Backups (S3-compatible: Backblaze B2, Cloudflare R2, DigitalOcean Spaces) --
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=seopulse-production
# e.g. https://<account>.r2.cloudflarestorage.com or https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# age public key (age1...). The private key stays OFF the server; see RESTORE.md.
BACKUP_AGE_RECIPIENT=
# UTC, HH:MM
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Optional dead-man switch (Better Stack heartbeat, healthchecks.io); pinged after each successful backup.
BACKUP_HEARTBEAT_URL=

# --- Phase 4 (billing and email) -----------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
