{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	request_body {
		max_size 1MB
	}

	# Deferred so these replace (not duplicate) headers set by the upstreams.
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-X-Powered-By
	}

	handle /api/* {
		# JSON only: compressing text/event-stream would buffer live audit updates.
		encode {
			zstd
			gzip
			match {
				header Content-Type application/json*
				header Content-Type application/problem+json*
			}
		}
		reverse_proxy api:8082 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		header {
			defer
			# Third parties: Cloudflare Turnstile, Google sign-in, Razorpay Checkout.
			# 'unsafe-inline': the landing effects run inline code in sandboxed srcdoc
			# iframes, which inherit this policy, and Google sign-in injects inline styles.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://accounts.google.com/gsi/client https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://cdn.razorpay.com; connect-src 'self' https://*.sentry.io https://accounts.google.com/gsi/ https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://challenges.cloudflare.com https://accounts.google.com/gsi/ https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		}
		reverse_proxy web:8080
	}

	log {
		output stdout
		# Verify and reset links carry single-use tokens in the query string,
		# PDF download links a signature. Caddy already redacts Cookie and
		# Authorization headers.
		format filter {
			wrap json
			request>uri query {
				delete token
				delete sig
			}
		}
	}
}
